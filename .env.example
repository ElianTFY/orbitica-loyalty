# COPY this file to .env for LOCAL development only. Never commit .env.
POSTGRES_DB=orbitica
POSTGRES_USER=orbitica
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
BFF_SHARED_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_CHARACTERS
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional customer notification channels.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_WEB_SERVICE_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_CHARACTERS
GOOGLE_WALLET_ENABLED=false
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY_BASE64=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.com
